# Optional. Copy to ".env" to override the defaults used by docker-compose.yml.
# Nothing here is needed for a normal `docker compose up`.

# How long a seat stays on hold before it expires, in seconds. Must be a positive whole number.
# Tip: set it to 30 to watch an application expire in the UI.
HOLD_DURATION_SECONDS=600

# The backend address the BROWSER calls. Read when the frontend container starts
# (written into /config.js), so changing it needs a restart, not a rebuild.
API_URL=http://localhost:8080

# Origins the browser UI may call the API from (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
