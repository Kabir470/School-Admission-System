{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      // A duplicate class name is an expected 409, decided by a unique index. EF would
      // log that constraint violation as an error with a stack trace on every attempt.
      // Real database failures still surface: they throw, and the exception handler logs them.
      "Microsoft.EntityFrameworkCore.Update": "Critical",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical"
    }
  },
  "AllowedHosts": "*"
}
